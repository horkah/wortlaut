{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "$ui/*": ["../../../packages/ui/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.svelte", "../../../packages/ui/**/*"]
}
