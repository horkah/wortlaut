# Vorlage für .env - kopieren mit `cp .env.example .env`.
# Gelesen von der config.py jeder App und von Docker Compose (`env_file:`).
#
# Ein Wert mit `$` gehört in **einfache** Anführungszeichen:
#
#     WORTLAUT_ADMIN_TOKEN='ein$Geheimnis'
#
# Compose setzt in unquotierten und doppelt quotierten Werten für `$name` ein,
# was in seiner Umgebung steht - aus `ein$Geheimnis` wird still `ein`, und zwar
# nur im Container. Token aus `openssl rand -base64` enthalten kein `$`.

# ── gemeinsam ────────────────────────────────────────────────────────────────
WORTLAUT_DATA_DIR=./data
WORTLAUT_STORAGE=local              # s3 ist in storage.py vorbereitet, nicht umgesetzt

# Die drei folgenden liest nur Compose: Sie sagen, wo auf dem Wirt liegt, was
# im Container einen festen Pfad hat - die Grundmodelle von Hugging Face, die
# Modelle von Ollama, und modelle/ und snapshots/ eines Trainings. Alles darin
# ist ersetzbar und groß; es gehört auf die große Platte, nicht zu den Daten.
WORTLAUT_MODELLCACHE=./data/modellcache
WORTLAUT_OLLAMACACHE=./data/ollama
WORTLAUT_TRAININGSABLAGE=./data/training

# Stimmen für das Vorlesen (`scripts/vorlesen.py --hole de_DE-thorsten-high`).
# Ohne Stimme liest der Browser vor.
WORTLAUT_STIMMEN_DIR=./modellcache/stimmen
WORTLAUT_VORLESEN_MOTOR=piper

# Worauf erkannt wird - für „schreiben", die Auswertung in „hören" und die
# Bewertung eines Laufs, damit ihre Rechenzeiten vergleichbar sind.
#   auto  die Karte, wenn CTranslate2 eine sieht, sonst der Prozessor
#   cuda  verlangt die Karte
#   cpu   bleibt beim Prozessor
# Ist die Karte voll, weicht die Erkennung auf den Prozessor aus.
WORTLAUT_GERAET=auto
# auto = int8_float16 auf der Karte, int8 auf dem Prozessor. Sonst int8 |
# int8_float16 | float16 | float32.
WORTLAUT_RECHENART=auto

# ── hören ────────────────────────────────────────────────────────────────────
# Textquelle per LLM. Leer = aus, es bleiben Upload und Foto.
#   openai     jede OpenAI-kompatible Schnittstelle - lokal Ollama, sonst
#              Groq, Gemini, Mistral mit BASE_URL und Schlüssel
#   anthropic  Claude, mit WORTLAUT_LLM_API_KEY
WORTLAUT_LLM_PROVIDER=openai
WORTLAUT_LLM_API_KEY=
WORTLAUT_LLM_MODEL=gemma2:9b
# Nur bei openai: wohin die Anfrage geht.
WORTLAUT_LLM_BASE_URL=http://ollama:11434/v1

# Die drei Geheimnisse von „hören". Leer heißt jeweils **abgeschaltet**, nicht
# offen. Erzeugen mit `openssl rand -base64 33`, jedes verschieden.
#
# Verwaltung: Profile anlegen, Zugänge ausgeben. Öffnet keinen Korpus.
WORTLAUT_AUTH_TOKEN=
# Aufsicht: jeden Korpus einsehen, sichern, löschen. Darf nicht dem
# Verwaltertoken gleichen - sonst bricht der Server beim Start ab.
WORTLAUT_ADMIN_TOKEN=
# Zuschnitt: vor allen Wegen unter /api/zuschnitt (Kopfzeile X-Editor-Key),
# neben dem Sprecherzugang.
WORTLAUT_EDITOR_KEY=

# Welche Grundmodelle in der Auswertung antreten - und in der Modelltafel von
# „lernen", mit genau diesen Zahlen. Die Reihenfolge ist die der Anzeige.
# large-v3 ist teuer, beantwortet aber, ob überhaupt ein fertiges Modell für
# diese Stimme reicht. Wer wenig Maschine hat, kürzt auf small.
WORTLAUT_AUSWERTUNG_MODELLE=small,medium,large-v3

# Wie lange Ollama sein Modell nach einer Anfrage auf der Karte hält. Länger
# spart die Ladezeit der nächsten Textquelle, belegt aber gut 5 GB auf der
# Karte, auf der trainiert wird.
OLLAMA_KEEP_ALIVE=1m

# ── lernen ───────────────────────────────────────────────────────────────────
# Wer Training anstoßen darf: Kopfzeile X-Trainer-Key vor Beauftragen und
# Neustart eines Laufs. Leer = hier trainiert niemand; Zusehen, Anhalten,
# Löschen und Freigeben bleiben beim Sprecher.
WORTLAUT_TRAINER_KEY=

# Worauf trainiert wird: die Vorgabe und was darüber hinaus zur Wahl steht.
# Jedes muss in WORTLAUT_AUSWERTUNG_MODELLE stehen, sonst fehlt seine
# Baseline. medium und größer nur mit LoRA.
WORTLAUT_LERNEN_BASISMODELL=openai/whisper-small
WORTLAUT_LERNEN_GRUNDMODELLE=openai/whisper-small,openai/whisper-medium,openai/whisper-large-v3
WORTLAUT_LERNEN_GERAET=cuda          # cuda | cpu - auf dem Prozessor dauert es Tage
WORTLAUT_LERNEN_TAKT_S=5             # wie oft der Läufer nach Aufträgen sieht
WORTLAUT_LERNEN_RESERVE_MB=2000      # was ein Lauf den Erkennern auf der Karte lässt
# Wo der Trainer Ollama vor jedem Lauf die Karte abnimmt. Leer: kein Ollama.
WORTLAUT_OLLAMA_URL=http://ollama:11434

# ── schreiben ────────────────────────────────────────────────────────────────
# Der Sprecher kommt aus dem Zugang, den der Browser vorlegt.

# Ein Stand für alle, Form <sprecher_id>/<version> - zum Erproben. Leer: die
# Freigabe je Sprecher, sonst WORTLAUT_ASR_MODELL.
WORTLAUT_MODELL_REF=
WORTLAUT_ASR_MODELL=small           # small | medium | large-v3

# local = faster-whisper im eigenen Prozess (uv sync --extra asr).
# remote schickt Stimmdaten an Dritte - siehe docs/datenschutz.md.
WORTLAUT_ASR=local
# Nur bei remote. Kein Kommentar hinter dem Gleichheitszeichen: Bei leerem
# Wert läse python-dotenv ihn als Wert.
WORTLAUT_ASR_ENDPOINT=
WORTLAUT_ASR_API_KEY=

# Wohin die bestätigten Korrekturen gehen. Leer = sie bleiben im Postausgang.
# Gesendet wird mit dem Zugang dessen, der bestätigt hat.
WORTLAUT_INTAKE_URL=http://localhost:8000/api/korpus/intake
