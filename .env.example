# Vorlage für .env — kopieren mit `cp .env.example .env`.
# Eingelesen ausschließlich in der jeweiligen config.py der App.

# ── gemeinsam ────────────────────────────────────────────────────────────────
WORTLAUT_DATA_DIR=./data
WORTLAUT_STORAGE=local              # local | s3

# Der Name, unter dem die Apps erreichbar sind, steht in der Konfiguration des
# Reverse Proxy auf dem Wirt und nicht hier (siehe docs/betrieb.md).

# ── hören ────────────────────────────────────────────────────────────────────
# Anbieter für die Texterzeugung. Leer = LLM-Quelle abgeschaltet,
# es bleibt der Textupload.
#
# Zwei Anbieter:
#   openai     — jede OpenAI-kompatible Schnittstelle. Lokal und kostenlos mit
#                Ollama (nichts verlässt die Maschine), oder Groq/Gemini/Mistral
#                mit deren BASE_URL und Schlüssel. Ollama braucht keinen Schlüssel.
#   anthropic  — Claude. Verlangt WORTLAUT_LLM_API_KEY, kostet pro Token.
#
# Vorgabe hier: lokales Ollama (siehe Dienst „ollama" in der compose.yaml).
WORTLAUT_LLM_PROVIDER=openai
WORTLAUT_LLM_API_KEY=
WORTLAUT_LLM_MODEL=gemma2:9b
# Nur bei anbieter=openai: Ziel der Anfrage. Lokal das Containernetz zu Ollama.
WORTLAUT_LLM_BASE_URL=http://ollama:11434/v1
# Leer = keine Authentifizierung (nur für die lokale Entwicklung).
WORTLAUT_AUTH_TOKEN=

# ── lernen (noch nicht implementiert) ────────────────────────────────────────
WORTLAUT_TRAINING_BACKEND=local     # local | remote
WORTLAUT_BASE_MODEL=openai/whisper-large-v3

# ── schreiben ────────────────────────────────────────────────────────────────
# Wessen Stimme. Steht in jeder Korrektur, die an „hören" zurückgeht.
WORTLAUT_SPRECHER_ID=

# Modellstand aus der Registry, Form <sprecher_id>/<version>. Leer heißt: es
# gibt noch keinen (weil „lernen" fehlt) — dann läuft das unveränderte
# Whisper-Modell aus WORTLAUT_ASR_MODELL. Damit fängt jede Installation an.
WORTLAUT_MODELL_REF=
WORTLAUT_ASR_MODELL=tiny            # tiny | base | small | medium | large-v3

# local = faster-whisper im eigenen Prozess (uv sync --extra asr).
# remote schickt Stimmdaten an Dritte — siehe docs/datenschutz.md.
WORTLAUT_ASR=local                  # local | remote
WORTLAUT_ASR_ENDPOINT=
WORTLAUT_ASR_API_KEY=

# Wohin die bestätigten Korrekturen gehen. Leer = sie bleiben im Postausgang
# liegen, statt verloren zu gehen. Der Token ist der WORTLAUT_AUTH_TOKEN
# der „hören"-Instanz.
WORTLAUT_INTAKE_URL=http://localhost:8000/api/korpus/intake
WORTLAUT_INTAKE_TOKEN=
