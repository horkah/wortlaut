# Vorlage für .env — kopieren mit `cp .env.example .env`.
# Eingelesen ausschließlich in der jeweiligen config.py der App.

# ── gemeinsam ────────────────────────────────────────────────────────────────
WORTLAUT_DATA_DIR=./data
WORTLAUT_STORAGE=local              # local | s3

# Nur für den Betrieb hinter Caddy: der Name, unter dem die App erreichbar
# ist. Gesetzt = Caddy holt ein Zertifikat dafür. Leer = HTTP auf :80.
WORTLAUT_DOMAIN=

# ── hören ────────────────────────────────────────────────────────────────────
# Anbieter für die Texterzeugung. Leer = LLM-Quelle abgeschaltet,
# es bleibt der Textupload.
WORTLAUT_LLM_PROVIDER=anthropic     # anthropic
WORTLAUT_LLM_API_KEY=
WORTLAUT_LLM_MODEL=claude-opus-5
# Leer = keine Authentifizierung (nur für die lokale Entwicklung).
WORTLAUT_AUTH_TOKEN=

# ── lernen (noch nicht implementiert) ────────────────────────────────────────
WORTLAUT_TRAINING_BACKEND=local     # local | remote
WORTLAUT_BASE_MODEL=openai/whisper-large-v3

# ── schreiben (noch nicht implementiert) ─────────────────────────────────────
WORTLAUT_SPRECHER_ID=
WORTLAUT_MODELL_REF=
WORTLAUT_ASR=local                  # local | remote
WORTLAUT_ASR_ENDPOINT=
WORTLAUT_ASR_API_KEY=
WORTLAUT_INTAKE_URL=
WORTLAUT_INTAKE_TOKEN=
